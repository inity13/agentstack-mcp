# AgentStack MCP — environment / binding reference.
# Stateless engine: run FREE/PRIVATE with NONE of these (fails open, free tier).
AGENTSTACK_BASE_URL=https://agentstack-mcp.pages.dev
FREE_DAILY=20
STARTER_DAILY=8000
PRO_DAILY=80000
PRICE_STARTER=price_xxx
PRICE_PRO=price_xxx
# Secrets via `wrangler pages secret put`, NEVER commit:
# STRIPE_SECRET_KEY=sk_live_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# KV binding (wrangler.toml): [[kv_namespaces]] binding = "AGENTSTACK_KV"
